{
  "name": "retryflow",
  "version": "1.0.0",
  "description": "A lightweight, zero-dependency retry engine for JavaScript & Node.js with exponential backoff, HTTP status filtering, timeout, and cancellation.",
  "type": "module",
  "main": "./src/index.cjs",
  "module": "./src/index.js",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "require": "./src/index.cjs"
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.js tests/*.test.cjs",
    "example:basic": "node examples/basic.js",
    "example:fetch": "node examples/fetch-example.js",
    "example:custom": "node examples/custom-retry.js"
  },
  "keywords": [
    "retry",
    "retryflow",
    "exponential-backoff",
    "backoff",
    "timeout",
    "fetch",
    "resilience",
    "promise-retry",
    "async"
  ],
  "author": "Rajkumar",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ]
}
